# Supabase project settings -> API.
#
# The anon key is PUBLIC by design: it ships in the browser bundle and anyone can
# read it. Row Level Security is the actual boundary. Never put the service_role
# key here - it bypasses RLS entirely and would be readable by anyone loading the
# app.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
